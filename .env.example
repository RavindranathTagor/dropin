# Postgres connection. Use the Supabase direct connection string in deployment.
# When DATABASE_URL is empty, GharDrop runs the same schema on local PGlite.
DATABASE_URL=

# Optional. Enables a Supabase Realtime subscription in addition to polling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys. Never expose these in client code.
SUPABASE_SERVICE_ROLE_KEY=
SARVAM_API_KEY=
FLAGSMITH_SERVER_KEY=
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_API_TOKEN=
FLAGSMITH_PAUSE_FEATURE_STATE_ID=

# Shared secret for the NudgeBee approval step. Admin sessions can pause without it.
OPS_ACTION_SECRET=
NUDGEBEE_WEBHOOK_URL=
NUDGEBEE_API_TOKEN=
NUDGEBEE_BASE_URL=https://app.nudgebee.com

SESSION_SECRET=

# Crewmark. SMTP_URL sends the 6-digit code to the account email.
# When SMTP_URL is empty, or CREWMARK_DEMO_OTP=1, the code is returned once to the signed-in session and is not written to logs.
SMTP_URL=
SMTP_FROM=
CREWMARK_DEMO_OTP=
